{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(grep:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": ["Bash(git reset:*)", "Bash(git merge:*)", "Bash(git rebase:*)"],
    "ask": [
      "Bash(rm:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["deepwiki", "context7"],
  "enabledPlugins": {
    "github@claude-plugins-official": true
  }
}
