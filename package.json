{
  "name": "oxlint-rules-gacha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run rules:build && next build",
    "build:deploy": "npm run test && npm run build",
    "codecheck": "npm run typecheck && npm run lint && npm run format && npm run knip",
    "dev": "next dev --turbopack",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --fix",
    "rules:build": "node scripts/build-rules.mts",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "16.3.6",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@stylexjs/stylex": "0.19.1",
    "@tsparticles/confetti": "4.4.0",
    "motion": "13.4.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "shuffle-text": "0.6.0",
    "zdog": "1.1.3"
  },
  "devDependencies": {
    "@stylexswc/nextjs-plugin": "0.19.0",
    "@stylexswc/postcss-plugin": "0.19.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/zdog": "1.1.7",
    "autoprefixer": "10.6.1",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.28",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "lefthook@2.1.10": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "@tsparticles/engine@4.4.0": false
  }
}
