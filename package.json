{
  "name": "oxlint-rules-gacha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "codecheck": "npm run typecheck && npm run lint && npm run format && npm run knip",
    "dev": "next dev --turbopack",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --fix",
    "rules:build": "tsx scripts/build-rules.ts",
    "setup:repo": "bash scripts/setup-repo.sh",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "motion": "13.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@stylexswc/nextjs-plugin": "0.18.6",
    "@stylexswc/postcss-plugin": "0.18.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.6.0",
    "knip": "6.32.3",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.26",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "lefthook@2.1.10": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true
  }
}
